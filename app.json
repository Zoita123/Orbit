{
  "expo": {
    "name": "orbit_app",
    "slug": "orbit_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbitapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zoeborrone.orbitapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.orbitapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "orbit usa tu ubicación para mostrarte ítems cercanos."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "orbit necesita acceso a tus fotos para que puedas agregar imágenes a tus productos.",
          "cameraPermission": "orbit necesita acceso a tu cámara para sacar fotos de tus productos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5077d1fa-fcb6-4feb-940b-aaa21114bca8"
      }
    },
    "owner": "zoeborrone"
  }
}
